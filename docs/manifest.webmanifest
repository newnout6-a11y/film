{
  "lang": "ru",
  "dir": "ltr",
  "name": "Film Beamer",
  "short_name": "Бимер",
  "description": "Закидывает файлы в Google Drive через быстрый канал GitHub Actions.",
  "id": "/film/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#07080c",
  "theme_color": "#0b0d14",
  "categories": ["utilities", "productivity"],
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Новый заброс",
      "short_name": "Заброс",
      "description": "Начать новую загрузку",
      "url": "./?action=beam"
    }
  ]
}
